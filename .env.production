# 微信云托管环境配置
TCB_ENV_ID=your-env-id-here

# 数据库配置 - 微信云托管MySQL
MYSQL_HOST=mysql.tencentcloudapi.com
MYSQL_PORT=3306
MYSQL_DATABASE=myblog
MYSQL_USERNAME=myblog_user
MYSQL_PASSWORD=your_mysql_password_here

# Redis配置 - 微信云托管Redis
REDIS_HOST=redis.tencentcloudapi.com
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Elasticsearch配置 - 腾讯云ES或自建
ELASTICSEARCH_HOST=es.tencentcloudapi.com
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_es_password_here

# JWT配置
JWT_SECRET=your_jwt_secret_key_here_minimum_256_bits

# 微信小程序配置
WECHAT_APP_ID=your_wechat_app_id_here
WECHAT_APP_SECRET=your_wechat_app_secret_here

# 腾讯云COS配置
COS_SECRET_ID=your_cos_secret_id_here
COS_SECRET_KEY=your_cos_secret_key_here
COS_BUCKET=your_cos_bucket_name_here
COS_REGION=ap-shanghai

# 应用配置
SPRING_PROFILES_ACTIVE=prod
FILE_UPLOAD_PATH=/app/uploads
MAX_FILE_SIZE=10485760

# 日志配置
LOG_LEVEL=INFO
LOG_FILE_PATH=/app/logs

# 服务URL配置
FRONTEND_SERVICE_URL=https://your-domain.com
BACKEND_SERVICE_URL=https://api.your-domain.com