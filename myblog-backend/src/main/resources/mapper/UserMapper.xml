<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ryan.myblog.mapper.UserMapper">

    <select id="selectByUsername" resultType="com.ryan.myblog.model.entity.User">
        SELECT * FROM tb_user WHERE username = #{username} AND deleted = 0
    </select>

    <select id="selectByEmail" resultType="com.ryan.myblog.model.entity.User">
        SELECT * FROM tb_user WHERE email = #{email} AND deleted = 0
    </select>

    <select id="selectByNickname" resultType="com.ryan.myblog.model.entity.User">
        SELECT * FROM tb_user WHERE nickname = #{nickname} AND deleted = 0
    </select>

</mapper>