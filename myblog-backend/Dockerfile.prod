# 生产环境 - 仅运行预构建的jar包
FROM eclipse-temurin:21-jre-alpine

# 设置时区（tzdata已包含在基础镜像中）
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# 创建应用目录
WORKDIR /app

# 创建非root用户
RUN addgroup -g 1000 spring && adduser -D -s /bin/sh -u 1000 -G spring spring

# 复制预构建的JAR文件
COPY target/*.jar app.jar

# 创建日志和上传目录（注意：挂载的卷会覆盖这些，但确保容器内目录存在）
RUN mkdir -p /app/logs /app/uploads && \
    chown -R spring:spring /app && \
    chmod -R 755 /app/logs /app/uploads

# 设置JVM参数
ENV JAVA_OPTS="-Xms768m -Xmx1536m -XX:+UseG1GC -XX:+UseContainerSupport -XX:MaxRAMPercentage=70.0"

# 暴露端口
EXPOSE 8081

# 切换到非root用户
USER spring

# 启动应用
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]

