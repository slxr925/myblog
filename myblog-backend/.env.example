# ============================================
# MyBlog Docker 部署环境变量配置
# ============================================

# 数据库配置
DB_HOST=mysql
DB_PORT=3306
DB_NAME=myblog
DB_USERNAME=myblog
DB_PASSWORD=your-secure-database-password
MYSQL_ROOT_PASSWORD=your-secure-root-password

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# JWT 配置（生产环境必须设置强密钥）
JWT_SECRET=your-jwt-secret-key-at-least-256-bits-long-for-production
JWT_EXPIRATION=604800

# Elasticsearch 配置
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# 文件上传配置
UPLOAD_PATH=/app/uploads
UPLOAD_URL_PREFIX=/uploads
UPLOAD_MAX_FILE_SIZE=10
UPLOAD_MAX_IMAGE_SIZE=5

# 应用配置
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

# 安全配置
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
RATE_LIMIT_ENABLED=true

# 日志配置
LOG_LEVEL=INFO
LOG_FILE_PATH=/app/logs/myblog.log

# JVM 配置（针对 Serverless 环境优化）
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -Xms128m -Xmx512m